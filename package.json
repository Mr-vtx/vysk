{
  "name": "vysk",
  "version": "0.1.1",
  "description": "Rust-powered image optimization CLI for any web project. Convert PNG and JPEG to WebP, cache results, and safely update image references. Install via npm, no Rust required.",
  "license": "MIT",
  "keywords": [
    "vysk",
    "image-optimization",
    "image-optimizer",
    "image-compression",
    "image-converter",
    "webp",
    "png-to-webp",
    "jpeg-to-webp",
    "rust",
    "cli",
    "npm",
    "web-performance",
    "build-tools",
    "nextjs",
    "react"
  ],
  "author": "Buikem Vans",
  "homepage": "https://www.npmjs.com/package/vysk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-vtx/vysk.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-vtx/vysk/issues"
  },
  "bin": {
    "vysk": "dist/cli.js"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/*.test.d.ts",
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "vysk",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build:native": "napi build --platform --release",
    "build:native:debug": "napi build --platform",
    "build:ts": "tsc",
    "build": "npm run build:native && npm run build:ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build:ts && node dist/scanner.test.js && node dist/cache.test.js && node dist/git.test.js && node dist/rewrite.test.js && node dist/gitignore.test.js && node dist/undo.test.js && node dist/clean.test.js && node dist/doctor.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}